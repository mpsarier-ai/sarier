[
 {
  "i": 1,
  "start": 0.0,
  "end": 2.94,
  "text": "¿Puede la IA hacernos pensar más?"
 },
 {
  "i": 2,
  "start": 2.94,
  "end": 5.54,
  "text": "Estás oyendo una canción en la radio"
 },
 {
  "i": 3,
  "start": 5.54,
  "end": 7.54,
  "text": "y está bastante buena."
 },
 {
  "i": 4,
  "start": 7.54,
  "end": 9.14,
  "text": "Te recuerda muchísimo a alguien más,"
 },
 {
  "i": 5,
  "start": 9.14,
  "end": 11.42,
  "text": "pero no logras acordarte de quién."
 },
 {
  "i": 6,
  "start": 11.42,
  "end": 13.6,
  "text": "Miras el nombre en el tablero del carro"
 },
 {
  "i": 7,
  "start": 13.6,
  "end": 14.88,
  "text": "y no lo reconoces."
 },
 {
  "i": 8,
  "start": 14.88,
  "end": 17.7,
  "text": "Cuando termina de sonar, el locutor dice:"
 },
 {
  "i": 9,
  "start": 17.7,
  "end": 18.9,
  "text": "\"Eso fue IA\"."
 },
 {
  "i": 10,
  "start": 18.9,
  "end": 21.1,
  "text": "De una te queda un mal sabor en la boca,"
 },
 {
  "i": 11,
  "start": 21.1,
  "end": 23.4,
  "text": "porque jamás lo habrías adivinado."
 },
 {
  "i": 12,
  "start": 23.4,
  "end": 25.54,
  "text": "Te parecía demasiado descabellado"
 },
 {
  "i": 13,
  "start": 25.54,
  "end": 27.56,
  "text": "que una canción con ese sonido"
 },
 {
  "i": 14,
  "start": 27.56,
  "end": 28.94,
  "text": "la pudiera generar una máquina."
 },
 {
  "i": 15,
  "start": 28.94,
  "end": 31.66,
  "text": "El resto del día caes en lo que se podría describir"
 },
 {
  "i": 16,
  "start": 31.66,
  "end": 34.3,
  "text": "como una minicrisis existencial impulsada por la IA."
 },
 {
  "i": 17,
  "start": 34.3,
  "end": 35.58,
  "text": "Piensas en quién eres,"
 },
 {
  "i": 18,
  "start": 35.58,
  "end": 37.22,
  "text": "en qué significa ser humano,"
 },
 {
  "i": 19,
  "start": 37.22,
  "end": 41.38,
  "text": "en qué va a pasar cuando el mundo real y el mundo artificial"
 },
 {
  "i": 20,
  "start": 41.38,
  "end": 42.8,
  "text": "ya no se puedan separar,"
 },
 {
  "i": 21,
  "start": 42.8,
  "end": 44.02,
  "text": "cuando se vuelvan uno solo."
 },
 {
  "i": 22,
  "start": 44.02,
  "end": 44.98,
  "text": "¿Alguien?"
 },
 {
  "i": 23,
  "start": 44.98,
  "end": 47.22,
  "text": "Y hacía mucho tiempo que no pensabas en nada de esto."
 },
 {
  "i": 24,
  "start": 47.22,
  "end": 49.48,
  "text": "¿Será que la IA sí puede hacernos reflexionar más"
 },
 {
  "i": 25,
  "start": 49.48,
  "end": 51.06,
  "text": "sobre nuestra humanidad?"
 },
 {
  "i": 26,
  "start": 51.06,
  "end": 53.38,
  "text": "¿Puede volvernos más filosóficos?"
 },
 {
  "i": 27,
  "start": 53.38,
  "end": 55.44,
  "text": "Hay un vértigo constante."
 },
 {
  "i": 28,
  "start": 55.44,
  "end": 58.98,
  "text": "Cada vez que la máquina logra hacer una cosa más"
 },
 {
  "i": 29,
  "start": 58.98,
  "end": 60.6,
  "text": "que creíamos nuestra,"
 },
 {
  "i": 30,
  "start": 60.6,
  "end": 62.9,
  "text": "salimos a buscar qué nos queda,"
 },
 {
  "i": 31,
  "start": 62.9,
  "end": 64.04,
  "text": "y eso agota."
 },
 {
  "i": 32,
  "start": 64.04,
  "end": 66.68,
  "text": "Pero ese vértigo también se puede ver como la prueba"
 },
 {
  "i": 33,
  "start": 66.68,
  "end": 68.52,
  "text": "de que todavía tienes un yo que perder."
 },
 {
  "i": 34,
  "start": 68.52,
  "end": 71.22,
  "text": "Así que sigue cuestionándolo todo,"
 },
 {
  "i": 35,
  "start": 71.22,
  "end": 73.94,
  "text": "como si tu propio yo dependiera de ello."
 }
]