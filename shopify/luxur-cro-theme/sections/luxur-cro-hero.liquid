{%- comment -%}
  LUXUR CRO: first screen of the home. Split layout (image + value proposition) so the offer, the main CTA
  and the trust chips are readable above the fold on mobile, instead of a banner with the text baked into the image.
  If no image is picked, the featured image of the first product of the fallback collection is used.
{%- endcomment -%}

{%- liquid
  assign hero_image = section.settings.image
  if hero_image == blank and section.settings.fallback_collection != blank
    assign hero_image = section.settings.fallback_collection.products.first.featured_media.preview_image
  endif
  assign hero_mobile_image = section.settings.mobile_image | default: hero_image
-%}

<style>
  #shopify-section-{{ section.id }} .luxur-hero {
    display: grid;
    background: {{ section.settings.background }};
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .luxur-hero__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: rgb(0 0 0 / 0.06);
  }

  #shopify-section-{{ section.id }} .luxur-hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
  }

  #shopify-section-{{ section.id }} .luxur-hero__badge {
    position: absolute;
    inset-block-start: 1rem;
    inset-inline-start: 1rem;
    padding: 0.5rem 0.875rem;
    border-radius: 60px;
    background: {{ section.settings.accent }};
    color: #1c1c1c;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .luxur-hero__content {
    display: grid;
    align-content: center;
    gap: 1.25rem;
    padding: 2rem var(--container-gutter) 2.25rem;
  }

  #shopify-section-{{ section.id }} .luxur-hero__eyebrow {
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  #shopify-section-{{ section.id }} .luxur-hero__title {
    margin: 0;
    font-size: clamp(2rem, 7vw, 3.75rem);
    line-height: 1.02;
    color: inherit;
  }

  #shopify-section-{{ section.id }} .luxur-hero__text {
    max-width: 34rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    opacity: 0.85;
  }

  #shopify-section-{{ section.id }} .luxur-hero__ctas {
    display: grid;
    gap: 0.625rem;
  }

  #shopify-section-{{ section.id }} .luxur-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 0 1.75rem;
    border-radius: 60px;
    border: 1px solid {{ section.settings.text_color }};
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
    transition: opacity 0.2s ease-in-out;
  }

  #shopify-section-{{ section.id }} .luxur-hero__cta--primary {
    background: {{ section.settings.button_background }};
    border-color: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
  }

  #shopify-section-{{ section.id }} .luxur-hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.75rem;
  }

  #shopify-section-{{ section.id }} .luxur-hero__chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  #shopify-section-{{ section.id }} .luxur-hero__rating {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
  }

  #shopify-section-{{ section.id }} .luxur-hero__stars {
    letter-spacing: 0.1em;
  }

  @media screen and (pointer: fine) {
    #shopify-section-{{ section.id }} .luxur-hero__cta:hover {
      opacity: 0.8;
    }
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .luxur-hero__ctas {
      grid-auto-flow: column;
      justify-content: start;
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .luxur-hero {
      grid-template-columns: 1fr 1fr;
      min-height: {{ section.settings.desktop_height }}vh;
    }

    #shopify-section-{{ section.id }} .luxur-hero--image-right .luxur-hero__media {
      order: 2;
    }

    #shopify-section-{{ section.id }} .luxur-hero__media {
      aspect-ratio: auto;
    }

    #shopify-section-{{ section.id }} .luxur-hero__content {
      padding: 4rem clamp(2rem, 6vw, 6rem);
      gap: 1.5rem;
    }
  }
</style>

<div class="luxur-hero {% if section.settings.image_right %}luxur-hero--image-right{% endif %}">
  <div class="luxur-hero__media">
    {%- if hero_image != blank -%}
      {%- if section.settings.image_link != blank -%}<a href="{{ section.settings.image_link }}" aria-label="{{ section.settings.button_1_text | escape }}">{%- endif -%}
      <picture>
        {%- if hero_mobile_image != hero_image -%}
          <source media="(max-width: 999px)" srcset="{{ hero_mobile_image | image_url: width: 800 }} 800w, {{ hero_mobile_image | image_url: width: 1200 }} 1200w" sizes="100vw">
        {%- endif -%}
        {{- hero_image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(max-width: 999px) 100vw, 50vw', widths: '600,800,1000,1200,1500,2000', alt: section.settings.title | strip_html | escape -}}
      </picture>
      {%- if section.settings.image_link != blank -%}</a>{%- endif -%}
    {%- else -%}
      {{- 'lifestyle-1' | placeholder_svg_tag: 'placeholder' -}}
    {%- endif -%}

    {%- if section.settings.badge != blank -%}
      <span class="luxur-hero__badge">{{ section.settings.badge }}</span>
    {%- endif -%}
  </div>

  <div class="luxur-hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="luxur-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h1 class="luxur-hero__title h1">{{ section.settings.title }}</h1>
    {%- endif -%}

    {%- if section.settings.rating_text != blank -%}
      <p class="luxur-hero__rating">
        <span class="luxur-hero__stars" aria-hidden="true">★★★★★</span>
        <span>{{ section.settings.rating_text }}</span>
      </p>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="luxur-hero__text">{{ section.settings.text }}</div>
    {%- endif -%}

    <div class="luxur-hero__ctas">
      {%- if section.settings.button_1_text != blank -%}
        <a href="{{ section.settings.button_1_link | default: routes.all_products_collection_url }}" class="luxur-hero__cta luxur-hero__cta--primary">{{ section.settings.button_1_text }}</a>
      {%- endif -%}

      {%- if section.settings.button_2_text != blank -%}
        <a href="{{ section.settings.button_2_link | default: routes.all_products_collection_url }}" class="luxur-hero__cta">{{ section.settings.button_2_text }}</a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="luxur-hero__chips">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              {%- render 'icon' with block.settings.icon, width: 16 -%}
            {%- endif -%}
            {{- block.settings.text -}}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "LUXUR · Hero conversión",
  "class": "shopify-section--luxur-cro-hero",
  "tag": "section",
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Primera pantalla de la home: imagen + propuesta de valor + botón principal + garantías. Pensado para que en celular se lea la oferta sin hacer scroll."
    },
    {
      "type": "header",
      "content": "Imagen"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen",
      "info": "Usa una foto sin texto. Recomendado 1600 × 2000 px."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Imagen en celular (opcional)"
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Colección de respaldo",
      "info": "Si no eliges imagen, se usa la foto del primer producto de esta colección."
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Enlace de la imagen"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Encuadre de la imagen",
      "options": [
        { "value": "center top", "label": "Arriba" },
        { "value": "center center", "label": "Centro" },
        { "value": "center bottom", "label": "Abajo" }
      ],
      "default": "center center"
    },
    {
      "type": "checkbox",
      "id": "image_right",
      "label": "Imagen a la derecha en escritorio",
      "default": false
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Etiqueta sobre la imagen",
      "default": "Nuevo drop"
    },
    {
      "type": "header",
      "content": "Texto"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Jeans hechos en Colombia"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Título",
      "default": "El jean que te queda <em>perfecto</em>"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Prueba social junto a las estrellas",
      "info": "Ej.: \"4,9/5 en +800 reseñas\". Usa un dato real; si lo dejas vacío no se muestran las estrellas."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Elige tu fit, recibe hoy en Medellín y si no te queda, lo cambias en 30 días.</p>"
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Botón principal",
      "default": "Comprar best sellers"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Enlace botón principal"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Botón secundario",
      "default": "Encuentra tu fit"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Enlace botón secundario"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Alto mínimo en escritorio",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 80
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fondo",
      "default": "#edebe6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Color de la etiqueta",
      "default": "#eecdcc"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Fondo botón principal",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Texto botón principal",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Garantía",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            { "value": "none", "label": "Ninguno" },
            { "value": "picto-delivery-truck", "label": "Camión" },
            { "value": "picto-return", "label": "Devolución" },
            { "value": "picto-credit-card", "label": "Tarjeta" },
            { "value": "picto-lock", "label": "Candado" },
            { "value": "picto-chat", "label": "Chat" },
            { "value": "picto-star", "label": "Estrella" },
            { "value": "picto-success", "label": "Check" }
          ],
          "default": "picto-success"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Envío gratis +$250.000"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LUXUR · Hero conversión",
      "blocks": [
        { "type": "chip", "settings": { "icon": "picto-delivery-truck", "text": "Envío gratis +$250.000" } },
        { "type": "chip", "settings": { "icon": "picto-return", "text": "Cambios 30 días" } },
        { "type": "chip", "settings": { "icon": "picto-credit-card", "text": "6 cuotas con Addi" } }
      ]
    }
  ]
}
{% endschema %}
